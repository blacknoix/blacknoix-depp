# Environment for the test runner, loaded via node --env-file in the test script.
# Not a secret file: it must be committed for `npm test` to work.
#
# LOG_SILENT suppresses structured log output so it does not interleave with
# the test runner's TAP stream.
LOG_SILENT=1

# Explicit-role migration (ADR-0011). Unit/db suites default to compat so
# legacy empty-role fixtures keep working; enforce coverage is explicit in
# dedicated tests via configureExplicitRolesMode("enforce").
AUTH_EXPLICIT_ROLES_MODE=compat

# Database-backed isolation suite (*.dbtest.ts). These are the committed
# local-dev defaults from infra/postgres/init + .env.example.
#
# DATABASE_URL MUST be depp_app (NOBYPASSRLS, non-owner).
# DATABASE_MIGRATION_URL MUST be depp_migrator (table owner).
DATABASE_URL=postgres://depp_app:depp_app_local_dev_only@localhost:5432/depp
DATABASE_MIGRATION_URL=postgres://depp_migrator:depp_migrator_local_dev_only@localhost:5432/depp
