# backend/api-gateway environment
#
# Copy this file to .env for LOCAL DEVELOPMENT. Never commit the real .env.
# Every variable below is read by runtime code, and this list is complete:
# config/env.ts, index.ts, auth/jwt/config.ts, auth/oidc/config.ts, lib/log.ts,
# and db/migrate.ts read nothing else.
#
# DEPLOYED ENVIRONMENTS DO NOT USE THIS FILE. Configuration and secrets are
# injected by the deployment mechanism as process environment variables. The
# container image contains no .env (see .dockerignore) and dotenv finds nothing
# to load. Any credential-looking value below is a well-known local-development
# default matching infra/postgres/init/ — not a secret, and never to be reused
# in a deployed environment.
#
# Container packaging (ADR-0013): the production Dockerfile runs
# `node dist/index.js` as USER node and expects these values via runtime env
# injection. Source packaging is not Docker/staging/IdP/scan evidence by itself.
# Local dist check: `npm run smoke:dist` (no DATABASE_URL; /health not_configured).

# Runtime environment. Also gates authentication -- see AUTH_MODE below.
NODE_ENV=development

# HTTP port. Must be a positive number; an invalid value stops startup.
PORT=3000

# Service name, currently used for identification only.
APP_NAME=depp-api-gateway

# How the gateway resolves the authenticated caller.
# Supported: dev-header | jwt
#
# "dev-header" is DEVELOPMENT ONLY: it trusts the client-supplied x-tenant-id
# header with no verification, and the service refuses to start with it when
# NODE_ENV=production.
#
# "jwt" validates a DEPP-signed access token (Authorization: Bearer <jwt>) and
# derives the principal from its claims. It is allowed in production and requires
# the JWT_* settings below; missing/invalid config stops startup.
#
# An unrecognised value stops startup rather than falling back to a default.
# See docs/architecture/adr/0002-authentication-seam.md and 0003.
AUTH_MODE=dev-header

# Explicit human role claims (ADR-0011). Supported: compat | enforce
#
# Parsed at startup via config/env.ts (applyExplicitRolesModeFromEnv). Invalid
# values stop startup before requests are served.
#
# compat (default when unset under AUTH_MODE=dev-header): humans with
#   missing/empty roles keep legacy operator-equivalent access and emit a
#   rate-limited warning (event=implicit_operator_compat). Transitional only —
#   not an enforce equivalent.
# enforce: missing/empty/unsupported-only human roles are denied on protected
#   human routes included in this foundation (findings, tenants/me).
#
# When AUTH_MODE=jwt, AUTH_EXPLICIT_ROLES_MODE MUST be set explicitly to
#   compat or enforce (unset fails startup). Do not infer from NODE_ENV.
# Production JWT deployments should set enforce after issuer roles (or
#   transitional AuthService operator minting) are verified.
# Readiness: docs/runbooks/explicit-roles-enforce-rollout.md and
#   tests/auth/enforce-readiness.test.ts / startup-explicit-roles.test.ts.
# AUTH_EXPLICIT_ROLES_MODE=compat
AUTH_EXPLICIT_ROLES_MODE=compat

# Required only when AUTH_MODE=jwt. The access token is a short-lived HS256 JWT.
#
# JWT_ACCESS_SECRET: HMAC signing secret, at least 32 characters. Keep it secret;
#   rotating it invalidates all outstanding access tokens (they die at next
#   refresh). Refresh tokens are opaque and hashed separately, so no secret is
#   needed for them.
# JWT_ISSUER / JWT_AUDIENCE: exact-match claims; a token with the wrong value is
#   rejected.
# JWT_ACCESS_TTL_SECONDS: access-token lifetime, 1..3600, default 900 (15m).
JWT_ACCESS_SECRET=
JWT_ISSUER=depp
JWT_AUDIENCE=depp-api
JWT_ACCESS_TTL_SECONDS=900

# Maximum accepted JSON request body: a `bytes` string ("100kb", "1mb") or a raw
# byte count. Unset uses the service default of 100kb. An invalid value stops
# startup.
#
# NOTE: this bounds only bodies that are parsed as JSON. Non-JSON bodies are not
# limited by it; bound overall request size at the reverse proxy / ingress.
# Auth/liveness batch ingest is designed to fit within this default.
BODY_LIMIT_DEFAULT=100kb

# Max events accepted by POST /v1/telemetry/events/batch (integer 1..100).
# Unset defaults to 50. Invalid values stop startup.
# TELEMETRY_BATCH_MAX_EVENTS=50

# PostgreSQL connection string.
#
# Optional in the current slice: with it unset the service starts normally and
# /health reports the database as "not_configured". A value that is present but
# malformed stops startup.
#
# Matches infra/docker-compose.yml. Note the user: the application connects as
# the least-privileged depp_app role, which is NOBYPASSRLS and owns no tables,
# because Row-Level Security does not apply to superusers or table owners
# (ADR-0001, ADR-0004).
DATABASE_URL=postgres://depp_app:depp_app_local_dev_only@localhost:5432/depp

# Privileged connection used ONLY to run migrations (npm run migrate:latest) and
# by the database-backed test suite to seed fixtures. Connects as depp_migrator,
# which owns the tables. Never used to serve application requests.
DATABASE_MIGRATION_URL=postgres://depp_migrator:depp_migrator_local_dev_only@localhost:5432/depp

# Upstream OIDC provider for human login (one provider in this slice).
# Leave OIDC_ISSUER unset to disable OIDC login entirely. If OIDC_ISSUER is set,
# ALL of the values below are required and validated at startup — a partial or
# invalid configuration stops the service from booting.
#
# OIDC_ISSUER: the provider's issuer URL (https). Its discovery document is
#   fetched, and the document's own issuer must match this value.
# OIDC_CLIENT_ID / OIDC_CLIENT_SECRET: confidential client credentials for the
#   authorization-code exchange.
# OIDC_REDIRECT_URI: the callback URL registered with the provider.
# OIDC_TENANT_ID: the DEPP tenant (UUID) this provider authenticates. The tenant
#   is fixed here, never taken from the browser.
#
# Login initiation (GET /v1/auth/oidc/start) generates state/nonce/PKCE, stores
# them server-side with a short TTL, and the callback is only honoured if it
# matches a live, unconsumed record. OIDC_SCOPE must include "openid".
# OIDC_INITIATION_TTL_SECONDS is the record lifetime (30..900, default 300).
#
# The initiation store is Postgres-backed (table oidc_initiations), so
# single-use + TTL semantics hold across restarts and multiple gateway
# instances. It uses the same DATABASE_URL as the rest of the service.
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=https://api.example.com/v1/auth/oidc/callback
# OIDC_TENANT_ID=
# OIDC_SCOPE=openid email profile
# OIDC_INITIATION_TTL_SECONDS=300

# Correlation bridge (ADR-0005), read by config/env.ts.
#
# CORRELATION_BRIDGE_ENABLED: global gate for submitFromDetection. Unset/empty
#   defaults to true. Accepts true/false, 1/0, on/off, yes/no; any other value
#   stops startup.
# CORRELATION_BRIDGE_DISABLED_TENANTS: comma-separated tenant UUIDs for which
#   the bridge fallback is off while signed correlation stays available. Applies
#   only when CORRELATION_BRIDGE_ENABLED is true. A non-UUID stops startup.
# CORRELATION_BRIDGE_ENABLED=true
# CORRELATION_BRIDGE_DISABLED_TENANTS=

# Set to 1 to suppress all structured log output. Used by the test runner via
# tests/test.env so log lines do not interleave with TAP output. Leave unset for
# normal development.
# LOG_SILENT=1
