# Copy this file to .env and fill in real values locally.
# Never commit the real .env file.

NODE_ENV=development
APP_NAME=depp

DATABASE_URL=
REDIS_URL=

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

PORT=3000
API_BASE_URL=http://localhost:3000

# Maximum accepted JSON request body. Accepts a `bytes` string ("100kb", "1mb")
# or a raw byte count. Unset uses the service default of 100kb.
# NOTE: this bounds only bodies parsed as JSON. Non-JSON bodies are not limited
# by it; bound overall request size at the reverse proxy / ingress.
BODY_LIMIT_DEFAULT=100kb

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=depp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

TENANT_CONTEXT_KEY=app.current_tenant
