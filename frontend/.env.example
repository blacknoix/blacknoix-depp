# Frontend environment (Vite). Copy to .env.local for local overrides.
# Never commit secrets.

# Optional default API origin. Leave empty to use same-origin (/v1 via Vite proxy).
# VITE_API_BASE_URL=

# Optional default session for local operator console (dev-header against api-gateway).
# Prefer interactive session gate; these are convenience defaults only.
# VITE_DEV_TENANT_ID=
